#!/usr/bin/env bash
# Hook pre-commit do Balcão (ativado por `npm run up`, via git config core.hooksPath .githooks).
# Bloqueia o commit se qualquer gate falhar. A lista inclui G1 (tipos: tsc em api/ e web/) e
# G2 (lint: eslint em api/ e web/), além das outras invariantes; todas juntas levam poucos segundos.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [ ! -d node_modules ] || [ ! -d api/node_modules ] || [ ! -d web/node_modules ]; then
  echo "[pre-commit] faltam dependências: rode 'npm run up' antes de commitar." >&2
  exit 1
fi

if ! node scripts/gates.mjs G1 G2 G3 G4 G5 G6 G7 G8 G9 G10 R1 R2 R3; then
  echo >&2
  echo "[pre-commit] commit bloqueado: corrija as violações acima (detalhe em docs/gates.md)." >&2
  exit 1
fi
